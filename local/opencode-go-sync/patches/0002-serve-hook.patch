+/// Run the catalog sync on demand for the `sync` subcommand.
+///
+/// Exit code 0 (no change) and 2 (updated and installed) are success: the sync
+/// already installed the new binary, and an explicit invocation must not
+/// re-exec (the operator can restart `serve` when ready). Anything else is an
+/// error carrying the script's exit code.
+fn run_sync(force: bool, dry_run: bool, no_install: bool) -> Result<()> {
+    let mut args = Vec::new();
+    if force {
+        args.push("--force".to_string());
+    }
+    if dry_run {
+        args.push("--dry-run".to_string());
+    }
+    if no_install {
+        args.push("--no-install".to_string());
+    }
+    match serve_hook::run_sync_cli(&args) {
+        Ok(0) | Ok(2) => Ok(()),
+        Ok(code) => Err(anyhow::anyhow!("sync script exited with code {code}")),
+        Err(error) => Err(anyhow::anyhow!(error)),
+    }
+}
+
+/// Run the catalog-sync pre-flight for the serve path, print and log the
+/// one-line outcome summary, and re-exec the freshly installed binary when the
+/// sync reported an update. All other subcommands skip this entirely.
+fn run_serve_preflight() {
+    let outcome = serve_hook::run_preflight();
+    let summary = outcome.summary();
+    println!("{summary}");
+
+    let logger = logging::create_logger("sync");
+    if outcome.is_failure() {
+        logger.warn(&summary, None);
+    } else {
+        logger.info(&summary, None);
+    }
+
+    if matches!(outcome, serve_hook::Outcome::Updated) {
+        if let Err(error) = serve_hook::reexec_self() {
+            let warning = format!("ccp-sync: {error}; serving the existing binary");
+            println!("{warning}");
+            logging::create_logger("sync").warn(&warning, None);
+        }
+    }
+}
